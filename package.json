{
  "name": "ml-visual",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "机器学习交互演示站 - 能玩、能看懂原理、能带走代码",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "crosscheck": "python scripts/crosscheck.py",
    "algo:json": "node scripts/crosscheck.mjs",
    "crosscheck:tree": "python scripts/crosscheck_tree.py",
    "crosscheck:logistic": "python scripts/crosscheck_logistic.py",
    "crosscheck:eval": "python scripts/crosscheck_eval.py",
    "crosscheck:svm": "python scripts/crosscheck_svm.py",
    "e2e": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/decision-tree/ --script scripts/tests/decision-tree.js",
    "e2e:home": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/ --script scripts/tests/home.js",
    "e2e:links:home": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/ --script scripts/tests/links.js",
    "e2e:links:demo": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/pca/ --script scripts/tests/links.js",
    "e2e:tree": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/decision-tree/ --script scripts/tests/decision-tree.js",
    "e2e:lr": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/linear-regression/ --script scripts/tests/linear-regression.js",
    "e2e:logistic": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/logistic-regression/ --script scripts/tests/logistic-regression.js",
    "e2e:eval": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/model-evaluation/ --script scripts/tests/model-evaluation.js",
    "e2e:svm": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/svm/ --script scripts/tests/svm.js",
    "crosscheck:nb": "python scripts/crosscheck_nb.py",
    "prepare:sms": "python scripts/prepare_sms.py",
    "e2e:nb": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/naive-bayes/ --script scripts/tests/naive-bayes.js",
    "crosscheck:ens": "python scripts/crosscheck_ensemble.py",
    "e2e:ens": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/ensemble-learning/ --script scripts/tests/ensemble-learning.js",
    "crosscheck:km": "python scripts/crosscheck_kmeans.py",
    "e2e:km": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/clustering/ --script scripts/tests/clustering.js",
    "crosscheck:pca": "python scripts/crosscheck_pca.py",
    "diagnose:pca": "node scripts/diagnose_pca.mjs",
    "e2e:pca": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/pca/ --script scripts/tests/pca.js",
    "crosscheck:nn": "python scripts/crosscheck_nn.py",
    "diagnose:nn": "node scripts/diagnose_nn.mjs",
    "e2e:nn": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/neural-network/ --script scripts/tests/neural-network.js",
    "unit:renderer": "node scripts/tests/zzprobe-renderer.mjs",
    "verify:all": "node scripts/verify-all.mjs",
    "verify:fast": "node scripts/verify-all.mjs --fast",
    "verify:bg": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/ --script scripts/tests/probe-bgperf.js",
    "verify:bg:motion": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/ --script scripts/tests/probe-bgperf.js --reduced-motion",
    "verify:bg:dpr": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/ --script scripts/tests/probe-bgperf.js --dpr 3",
    "verify:bg:mobile": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/ --script scripts/tests/probe-mobile.js --size 420,900",
    "shot:home": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/ --script scripts/tests/shot-home-dark.js --shot .shots/home-dark.png --viewport",
    "check:heads": "node scripts/check-heads.mjs",
    "nya:smoke": "node scripts/nya-smoke.mjs",
    "e2e:quality": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/linear-regression/ --script scripts/tests/probe-quality.js",
    "e2e:quality:mobile": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/linear-regression/ --script scripts/tests/probe-quality.js --size 420,900",
    "e2e:nya": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/linear-regression/ --script scripts/tests/nya-panel.js --size 1440,900",
    "e2e:nya:mobile": "node scripts/e2e.mjs --serve --url http://127.0.0.1:4173/demos/linear-regression/ --script scripts/tests/nya-panel.js --size 430,900",
    "check:nya-state": "node scripts/check-nya-state.mjs",
    "check:server": "node scripts/check-server-path.mjs",
    "check:vercel": "node scripts/check-vercel-bundle.mjs",
    "verify:release": "npm run typecheck && npm run build && npm run verify:all",
    "nya:prompt": "node scripts/nya-prompt.mjs"
  },
  "dependencies": {
    "echarts": "^5.5.1",
    "katex": "^0.16.11"
  },
  "devDependencies": {
    "@types/node": "^26.5.1",
    "typescript": "~5.6.3",
    "vite": "^5.4.10"
  }
}
