# 依赖
node_modules/

# 构建产物（由 CI / Vercel 现场构建，不入库）
dist/

# Vite 临时文件
*.timestamp-*.mjs
.vite/

# 本地 Python 环境（对拍脚本用）
.venv-python
__pycache__/
*.pyc

# 编辑器 / 系统
.vscode/
.idea/
.DS_Store
Thumbs.db

# 日志
*.log
npm-debug.log*

# 本地截图（e2e 输出，仅供人看，不必入库）
.shots/

# 环境变量（本地覆盖用）
.env.local
.env.*.local

# 移动端壳工程产物（Capacitor 输出：www/ 与 android/ 均为构建结果，不入库）
ml-visual-app/

# 截图产物（e2e 输出，无点前缀的目录）
shots/
